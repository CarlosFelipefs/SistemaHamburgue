<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: #111111;
            font-family: 'DM Sans', sans-serif;
            color: #ccc;
        }

        /* ── SIDEBAR ─────────────────────────────── */
        .sidebar {
            width: 220px;
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            background: #0d0d0d;
            border-right: 1px solid #1f1f1f;
            display: flex;
            flex-direction: column;
            padding-bottom: 1rem;
            z-index: 100;
        }

        .sidebar-logo {
            padding: 22px 18px 18px;
            border-bottom: 1px solid #1f1f1f;
            margin-bottom: 8px;
        }

        .logo-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: #E8650A;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .logo-text {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 22px;
            letter-spacing: 1.5px;
            color: #f0f0f0;
            line-height: 1;
        }

        .logo-sub {
            font-size: 10px;
            color: #444;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* ── NAV ─────────────────────────────────── */
        .nav-section {
            padding: 0 10px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 2px;
            overflow-y: auto;
        }

        .nav-label {
            font-size: 9px;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #333;
            padding: 14px 10px 6px;
            font-weight: 500;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 8px;
            color: #555;
            font-size: 13.5px;
            font-weight: 400;
            text-decoration: none;
            transition: all 0.15s;
            position: relative;
        }

        .sidebar a:hover {
            background: #1a1a1a;
            color: #ccc;
        }

        .sidebar a.active,
        .sidebar a[href="@(ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() == "home" ? "/" : "")"] {
            background: rgba(232, 101, 10, 0.12);
            color: #E8650A;
            font-weight: 500;
        }

        .sidebar a.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 4px;
            bottom: 4px;
            width: 3px;
            background: #E8650A;
            border-radius: 0 3px 3px 0;
        }

        .sidebar i {
            font-size: 15px;
            width: 18px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar hr {
            border-color: #1a1a1a;
            margin: 8px 10px;
        }

        .sidebar a.text-danger {
            color: #6a2424 !important;
        }

        .sidebar a.text-danger:hover {
            background: rgba(180, 40, 40, 0.1);
            color: #e05050 !important;
        }

        /* ── CONTENT ─────────────────────────────── */
        .content {
            margin-left: 220px;
            min-height: 100vh;
            background: #111111;
        }

        /* ── TOPBAR (injetado em _Layout) ─────────── */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 28px;
            background: #0d0d0d;
            border-bottom: 1px solid #1f1f1f;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 26px;
            letter-spacing: 2px;
            color: #f0f0f0;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-primary {
            background: #E8650A !important;
            border-color: #E8650A !important;
            border-radius: 8px !important;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            font-weight: 500;
            padding: 7px 16px;
        }

        .btn-primary:hover {
            background: #d05a08 !important;
            border-color: #d05a08 !important;
        }

        /* ── CARDS / TABLES ──────────────────────── */
        .card {
            background: #161616 !important;
            border: 1px solid #222 !important;
            border-radius: 12px !important;
        }

        .card-header {
            background: transparent !important;
            border-bottom: 1px solid #1f1f1f !important;
            padding: 14px 18px;
        }

        .card-title {
            font-size: 13px;
            font-weight: 500;
            color: #ccc;
            margin: 0;
        }

        .card-body {
            padding: 18px;
        }

        .table {
            color: #aaa;
            border-radius: 0;
        }

        .table th {
            font-size: 10px;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #444;
            border-bottom: 1px solid #1f1f1f;
            font-weight: 500;
            padding: 10px 12px;

        }

            .table td {
                border-bottom: 1px solid #1a1a1a;
                padding: 10px 12px;
                font-size: 13.5px;
                color: #ccc;
                vertical-align: middle;
                background: #1a1a1a;
            }


        /* ── BADGES ──────────────────────────────── */
        .badge {
            font-size: 11px;
            font-weight: 400;
            padding: 4px 10px;
            border-radius: 20px;
        }

        .badge-success, .badge.bg-success {
            background: rgba(76,175,80,0.12) !important;
            color: #4caf50 !important;
        }

        .badge-warning, .badge.bg-warning {
            background: rgba(232,101,10,0.12) !important;
            color: #E8650A !important;
        }

        .badge-secondary, .badge.bg-secondary {
            background: rgba(120,120,120,0.12) !important;
            color: #888 !important;
        }

        /* ── FORMS ───────────────────────────────── */
        .form-control, .form-select {
            background: #161616 !important;
            border: 1px solid #2a2a2a !important;
            color: #ccc !important;
            border-radius: 8px !important;
            font-size: 14px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #E8650A !important;
            box-shadow: 0 0 0 3px rgba(232,101,10,0.15) !important;
        }

        .form-label {
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #555;
            font-weight: 500;
            margin-bottom: 6px;
        }

        /* ── PAGE PADDING ────────────────────────── */
        .page-content {
            padding: 28px;
        }

        /* ── STAT CARDS ──────────────────────────── */
        .stat-card {
            background: #161616;
            border: 1px solid #222;
            border-radius: 12px;
            padding: 18px;
        }

        .stat-card.highlight {
            background: #E8650A;
            border-color: #E8650A;
        }

        .stat-label {
            font-size: 10px;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #555;
            margin-bottom: 8px;
        }

        .stat-card.highlight .stat-label { color: rgba(255,255,255,0.6); }

        .stat-value {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 32px;
            letter-spacing: 1px;
            color: #eee;
            line-height: 1;
        }

        .stat-card.highlight .stat-value { color: #fff; }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-logo">
            <a class="logo-badge" href="/">
                <div class="logo-icon">🍔</div>
                <div>
                    <div class="logo-text">Hamburgueria</div>
                    <div class="logo-sub">Admin Panel</div>
                </div>
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-label">Principal</div>
            <a href="@Url.Action("Index", "Home")"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="@Url.Action("Index", "Pedido")"><i class="bi bi-receipt"></i> Pedidos</a>
            <a href="@Url.Action("Index", "Produto")"><i class="bi bi-basket"></i> Produtos</a>
            <a href="@Url.Action("Index", "Categoria")"><i class="bi bi-tags"></i> Categorias</a>
            <a href="@Url.Action("Index", "Ingrediente")">
                <i class="bi bi-egg-fried"></i> Ingredientes
            </a>

            <div class="nav-label">Gestão</div>
            <a href="@Url.Action("Index", "Cliente")"><i class="bi bi-people"></i> Clientes</a>
            <a href="@Url.Action("Index", "Mesa")"><i class="bi bi-grid"></i> Mesas</a>
            <a href="@Url.Action("Index", "Estoque")"><i class="bi bi-box"></i> Estoque</a>
            <a href="@Url.Action("Index", "Funcionario")"><i class="bi bi-person-badge"></i> Funcionários</a>

            <hr />
            <a href="@Url.Action("Logout", "Funcionario")" class="text-danger">
                <i class="bi bi-box-arrow-right"></i> Sair
            </a>
        </div>
    </div>

    <!-- CONTEÚDO -->
    <div class="content">
        <div class="topbar">
            <div class="topbar-title">@ViewBag.Title</div>
            <div class="topbar-actions">
                <!-- Adicione botões contextuais por página via ViewBag.Actions -->
                @Html.Raw(ViewBag.TopbarActions ?? "")
            </div>
        </div>
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Destaca o link ativo no menu -->
    <script>
        const path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.sidebar a').forEach(a => {
            const href = a.getAttribute('href')?.toLowerCase();
            if (href && href !== '/' && path.startsWith(href)) {
                a.classList.add('active');
            } else if (href === '/' && path === '/') {
                a.classList.add('active');
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>