@model IEnumerable<SistemaHamburgueria.Models.Funcionario>
@{
    ViewBag.Title = "Funcionários";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Funcionários</h2>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@Html.ActionLink("+ Novo Funcionário", "Create", null, new { @class = "btn btn-primary mb-3" })

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Cargo</th>
            <th>E-mail (Login)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.Nome</td>
                <td>@f.Cargo</td>
                <td>@f.login</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = f.Id }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Excluir", "Delete", new { id = f.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>
