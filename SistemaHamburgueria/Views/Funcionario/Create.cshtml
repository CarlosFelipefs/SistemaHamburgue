@model SistemaHamburgueria.Models.Funcionario
@{
    ViewBag.Title = "Novo Funcionário";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Novo Funcionário</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Nome)
        @Html.TextBoxFor(m => m.Nome, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Cargo)
        @Html.TextBoxFor(m => m.Cargo, new { @class = "form-control" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.login)
        @Html.TextBoxFor(m => m.login, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.login, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        <label>Senha</label>
        <input type="password" name="Senha" class="form-control" autocomplete="new-password" />
        @Html.ValidationMessageFor(m => m.Senha, "", new { @class = "text-danger" })
        <small class="text-muted">Mínimo 6 caracteres.</small>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ms-2" })
}