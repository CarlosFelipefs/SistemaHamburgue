@model SistemaHamburgueria.Models.DashboardViewModel
@using SistemaHamburgueria.Enums
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CARDS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card highlight">
            <div class="stat-label">Faturamento hoje</div>
            <div class="stat-value">R$@Model.FaturamentoHoje.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Pedidos hoje</div>
            <div class="stat-value">@Model.PedidosHoje</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Ticket médio</div>
            <div class="stat-value">R$@Model.TicketMedio.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Mesas ativas</div>
            <div class="stat-value">@Model.MesasAtivas/@Model.TotalMesas</div>
        </div>
    </div>
</div>

<!-- GRÁFICOS -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title">Pedidos por Dia</span>
                <span style="font-size:11px;color:#444;">Últimos 7 dias</span>
            </div>
            <div class="card-body">
                <canvas id="graficoPedidos" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Status das Mesas</span>
            </div>
            <div class="card-body">
                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">
                    @foreach (var mesa in Model.Mesas)
                    {
                        var ocupada = mesa.StatusMesa == StatusMesa.Ocupada;
                        var bg = ocupada ? "rgba(232,101,10,0.1)" : "#161616";
                        var border = ocupada ? "rgba(232,101,10,0.3)" : "#222";
                        var numCor = ocupada ? "#E8650A" : "#eee";
                        var stCor = ocupada ? "rgba(232,101,10,0.7)" : "#555";
                        <div style="background:@bg;border:1px solid @border;border-radius:8px;padding:10px 8px;text-align:center;">
                            <div style="font-family:'Bebas Neue',sans-serif;font-size:20px;color:@numCor;line-height:1;">@mesa.Numero</div>
                            <div style="font-size:9px;letter-spacing:1px;text-transform:uppercase;color:@stCor;margin-top:2px;">@mesa.StatusMesa</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><span class="card-title">Pedidos Recentes</span></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <tbody>
                        @foreach (var p in Model.PedidosRecentes)
                        {
                            var dotCor = p.StatusPedido == StatusPedido.Entregue ? "#4caf50"
                                       : p.StatusPedido == StatusPedido.EmPreparo ? "#E8650A"
                                       : p.StatusPedido == StatusPedido.Cancelado ? "#e05050"
                                       : "#888";

                            var badgeSt = p.StatusPedido == StatusPedido.Entregue ? "background:rgba(76,175,80,0.12);color:#4caf50;"
                                        : p.StatusPedido == StatusPedido.EmPreparo ? "background:rgba(232,101,10,0.12);color:#E8650A;"
                                        : p.StatusPedido == StatusPedido.Cancelado ? "background:rgba(224,80,80,0.12);color:#e05050;"
                                        : "background:rgba(120,120,120,0.12);color:#888;";
                            <tr>
                                <td>
                                    <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:@dotCor;margin-right:8px;"></span>
                                    @(p.ItensPedido?.FirstOrDefault()?.Produto?.Nome ?? "Pedido #" + p.Id)
                                    <small style="display:block;font-size:11px;color:#555;">
                                        @(p.Mesa != null ? "Mesa " + p.Mesa.Numero : "Delivery")
                                    </small>
                                </td>
                                <td>
                                    <span style="@badgeSt font-size:11px;padding:3px 10px;border-radius:20px;">
                                        @p.StatusPedido
                                    </span>
                                </td>
                                <td style="text-align:right;color:#ddd;font-weight:500;">
                                    R$@p.ValorTotal.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><span class="card-title">Top Produtos</span></div>
            <div class="card-body">
                @{ int rank = 1; }
                @foreach (var p in Model.TopProdutos)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid #1c1c1c;">
                        <span style="font-family:'Bebas Neue',sans-serif;font-size:18px;color:#2e2e2e;min-width:18px;">@rank</span>
                        <span style="flex:1;font-size:13px;color:#bbb;">@p.Nome</span>
                        <div style="flex:1;height:4px;background:#222;border-radius:3px;overflow:hidden;">
                            <div style="width:@(p.Percentual)%;height:100%;background:#E8650A;border-radius:3px;"></div>
                        </div>
                        <span style="font-size:11px;color:#555;min-width:40px;text-align:right;">@p.Quantidade un</span>
                    </div>
                    rank++;
                }
                @if (!Model.TopProdutos.Any())
                {
                    <p style="color:#333;font-size:13px;text-align:center;padding:20px 0;">Nenhum dado ainda.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- SCRIPTS -->
<script>
    const orange    = '#E8650A';
    const dim       = 'rgba(232,101,10,0.12)';
    const gridColor = '#1f1f1f';

    Chart.defaults.color        = '#555';
    Chart.defaults.borderColor  = gridColor;
    Chart.defaults.font.family  = "'DM Sans', sans-serif";

    new Chart(document.getElementById('graficoPedidos'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Labels)),
            datasets: [{
                label: 'Pedidos',
                data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PedidosPorDia)),
                backgroundColor: dim,
                borderColor: orange,
                borderWidth: 1.5,
                borderRadius: 5,
                hoverBackgroundColor: 'rgba(232,101,10,0.25)'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: { backgroundColor: '#1a1a1a', borderColor: '#333', borderWidth: 1 }
            },
            scales: {
                x: { grid: { color: gridColor }, ticks: { font: { size: 11 } } },
                y: { grid: { color: gridColor }, ticks: { font: { size: 11 }, stepSize: 1 } }
            }
        }
    });
</script>