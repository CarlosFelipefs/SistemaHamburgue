@model SistemaHamburgueria.Models.Pedido
@{
    ViewBag.Title = "Adicionar Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Pedido #@Model.Id — Mesa @Model.Mesa.Numero</h2>
<p><strong>Total atual:</strong> R$ @Model.ValorTotal.ToString("F2")</p>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@using (Html.BeginForm("AddItem", "Pedido", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="PedidoId" value="@Model.Id" />

    <div class="form-group mb-3">
        <label class="form-label">Produto</label>
        @Html.DropDownList("ProdutoId", (SelectList)ViewBag.ProdutoId, "-- Selecione --", new { @class = "form-select" })
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Quantidade</label>
        <input type="number" name="Quantidade" value="1" min="1" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Adicionar</button>
    @Html.ActionLink("Ver Pedido", "Details", new { id = Model.Id }, new { @class = "btn btn-secondary ms-2" })
}

@if (Model.ItensPedido != null && Model.ItensPedido.Any())
{
    <hr />
    <h5>Itens no pedido</h5>
    <table class="table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th>Preço Unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ItensPedido)
            {
                <tr>
                    <td>@item.Produto.Nome</td>
                    <td>@item.Quantidade</td>
                    <td>R$ @item.PrecoUnitario.ToString("F2")</td>
                    <td>R$ @item.Subtotal.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}