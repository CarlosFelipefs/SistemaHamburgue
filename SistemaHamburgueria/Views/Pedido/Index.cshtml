@model IEnumerable<SistemaHamburgueria.Models.Pedido>
@{
    ViewBag.Title = "Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Pedidos</h2>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@Html.ActionLink("+ Novo Pedido", "Create", null, new { @class = "btn btn-primary mb-3" })

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Mesa</th>
            <th>Data</th>
            <th>Total</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>Mesa @p.Mesa.Numero</td>
                <td>@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                <td>R$ @p.ValorTotal.ToString("F2")</td>
                <td>@p.StatusPedido</td>
                <td>
                    @Html.ActionLink("Detalhes", "Details", new { id = p.Id }, new { @class = "btn btn-sm btn-secondary" })
                </td>
            </tr>
        }
    </tbody>
</table>