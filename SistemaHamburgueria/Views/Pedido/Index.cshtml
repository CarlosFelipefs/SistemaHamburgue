@model IEnumerable<SistemaHamburgueria.Models.Pedido>

@{
    ViewBag.Title = "Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Pedidos</h2>

<p>
    @Html.ActionLink("Novo Pedido", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped">
    <tr>
        <th>Mesa</th>
        <th>Data</th>
        <th>Total</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Mesa?.Numero</td>
            <td>@item.DataPedido</td>
            <td>R$ @item.ValorTotal</td>
            <td>
                @Html.ActionLink("Detalhes", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" }) |
                @Html.ActionLink("Finalizar", "Finalizar", new { id = item.Id }, new { @class = "btn btn-success btn-sm" })
            </td>
        </tr>
    }
</table>