@model SistemaHamburgueria.Models.Pedido
@{
    ViewBag.Title = "Detalhes do Pedido #" + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Pedido #@Model.Id — Mesa @Model.Mesa?.Numero</h2>
<p><strong>Data:</strong> @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Status:</strong> @Model.StatusPedido</p>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Qtd</th>
            <th>Preço Unit.</th>
            <th>Subtotal</th>
            <th>Ação</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ItensPedido)
        {
            <tr>
                <td>@item.Produto.Nome</td>
                <td>@item.Quantidade</td>
                <td>R$ @item.PrecoUnitario.ToString("F2")</td>
                <td>R$ @item.Subtotal.ToString("F2")</td>
                <td>
                    @using (Html.BeginForm("RemoverItem", "Pedido", new { id = item.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Remover item e devolver estoque?')">Remover</button>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3"><strong>Total</strong></td>
            <td colspan="2"><strong>R$ @Model.ValorTotal.ToString("F2")</strong></td>
        </tr>
    </tfoot>
</table>

@if (Model.StatusPedido == SistemaHamburgueria.Enums.StatusPedido.EmPreparo)
{
    <div class="row mt-3">
        <!-- FINALIZAR -->
        <div class="col-md-6">
            @using (Html.BeginForm("Finalizar", "Pedido", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label><strong>Forma de Pagamento</strong></label>
                    @Html.DropDownList("formaPagamento",
                        new SelectList(Enum.GetValues(typeof(SistemaHamburgueria.Enums.FormaPagamento))
                            .Cast<SistemaHamburgueria.Enums.FormaPagamento>()
                            .Select(f => new SelectListItem { Value = ((int)f).ToString(), Text = f.ToString() })),
                        new { @class = "form-control mb-2" })
                </div>
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Finalizar pedido?')">✔ Finalizar Pedido</button>
            }
        </div>

        <!-- CANCELAR -->
        <div class="col-md-6">
            @using (Html.BeginForm("Cancelar", "Pedido", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning mt-4"
                        onclick="return confirm('Cancelar pedido? O estoque será devolvido.')">✖ Cancelar Pedido</button>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("+ Adicionar Item", "AddItem", new { id = Model.Id }, new { @class = "btn btn-primary" })
    </div>
}

<hr />
@Html.ActionLink("← Voltar à lista", "Index", null, new { @class = "btn btn-secondary" })
