@model SistemaHamburgueria.Models.Pedido
@{
    ViewBag.Title = "Detalhes do Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Response.Charset = "utf-8";
}

<h2>Pedido @Model.Id &larr; Mesa @Model.Mesa.Numero</h2>
<p><strong>Data:</strong> @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Status:</strong> @Model.StatusPedido</p>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Qtd</th>
            <th>Preço Unit.</th>
            <th>Subtotal</th>
            <th>Ação</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ItensPedido)
        {
            <tr>
                <td>@item.Produto.Nome</td>
                <td>@item.Quantidade</td>
                <td>R$ @item.PrecoUnitario.ToString("F2")</td>
                <td>R$ @item.Subtotal.ToString("F2")</td>
                <td>
                    @using (Html.BeginForm("RemoverItem", "Pedido", new { id = item.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Remover item?')">
                            Remover
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3"><strong>Total</strong></td>
            <td colspan="2"><strong>R$ @Model.ValorTotal.ToString("F2")</strong></td>
        </tr>
    </tfoot>
</table>

@if (Model.StatusPedido == SistemaHamburgueria.Enums.StatusPedido.EmPreparo)
{
    <div class="row mt-3">
        <div class="col-md-6">
            @using (Html.BeginForm("Finalizar", "Pedido", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label"><strong>Forma de Pagamento</strong></label>
                    <select name="formaPagamento" class="form-select mb-2">
                        <option value="1">Dinheiro</option>
                        <option value="2">Cartão Crédito</option>
                        <option value="3">Cartão Débito</option>
                        <option value="4">Pix</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('Finalizar pedido?')">
                     Finalizar Pedido
                </button>
            }
        </div>
        <div class="col-md-6">
            @using (Html.BeginForm("Cancelar", "Pedido", new { id = Model.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning mt-4"
                        onclick="return confirm('Cancelar pedido?')">
                     Cancelar Pedido
                </button>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("+ Adicionar Item", "AddItem", new { id = Model.Id }, new { @class = "btn btn-primary" })
    </div>
}

<hr />
@Html.ActionLink("Voltar", "Index", null, new { @class = "btn btn-secondary" })