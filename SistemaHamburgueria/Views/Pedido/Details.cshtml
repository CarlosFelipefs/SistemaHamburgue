@model SistemaHamburgueria.Models.Pedido
@{
    ViewBag.Title = "Detalhes do Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusStyle = "";
    var statusText = "";
    switch (Model.StatusPedido)
    {
        case SistemaHamburgueria.Enums.StatusPedido.EmPreparo:
            statusStyle = "background:rgba(232,101,10,0.12);color:#E8650A;";
            statusText = "Em Preparo"; break;
        case SistemaHamburgueria.Enums.StatusPedido.Pronto:
            statusStyle = "background:rgba(33,150,243,0.12);color:#42a5f5;";
            statusText = "Pronto"; break;
        case SistemaHamburgueria.Enums.StatusPedido.Entregue:
            statusStyle = "background:rgba(76,175,80,0.12);color:#4caf50;";
            statusText = "Entregue"; break;
        case SistemaHamburgueria.Enums.StatusPedido.Cancelado:
            statusStyle = "background:rgba(224,80,80,0.12);color:#e05050;";
            statusText = "Cancelado"; break;
    }

    bool isDelivery = Model.MesaId == null && Model.Cliente != null;
    var endereco = Model.Cliente?.Enderecos?.FirstOrDefault();
}

@if (TempData["Sucesso"] != null)
{
    <div style="background:rgba(76,175,80,0.1);border:1px solid rgba(76,175,80,0.2);color:#4caf50;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ✓ @TempData["Sucesso"]
    </div>
}
@if (TempData["Erro"] != null)
{
    <div style="background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ⚠ @TempData["Erro"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:2px;color:#E8650A;text-transform:uppercase;">Pedidos</div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:#f0f0f0;line-height:1;">
            Pedido #@Model.Id
            @if (isDelivery)
            {
                <span style="font-size:18px;color:#555;letter-spacing:1px;">Delivery</span>
            }
            else if (Model.Mesa != null)
            {
                <span style="font-size:18px;color:#555;letter-spacing:1px;">· Mesa @Model.Mesa.Numero</span>
            }
        </div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <span style="@statusStyle font-size:12px;padding:5px 14px;border-radius:20px;font-weight:500;">
            @statusText
        </span>
        @Html.ActionLink(" Voltar", "Index", null, new
        {
            style = "background:#1f1f1f;border:1px solid #333;color:#ccc;border-radius:6px;padding:7px 14px;font-size:13px;text-decoration:none;"
        })
    </div>
</div>

<div class="row g-3">

    <div class="col-md-4">

        <div class="card mb-3">
            <div class="card-header" style="border-left:3px solid #E8650A;">
                <span class="card-title">Informacoes</span>
            </div>
            <div class="card-body">
                <div style="display:flex;flex-direction:column;gap:14px;">

                    @if (isDelivery)
                    {
                        <div>
                            <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Tipo</div>
                            <div style="font-size:15px;color:#eee;font-weight:500;"> Delivery</div>
                        </div>
                    }
                    else if (Model.Mesa != null)
                    {
                        <div>
                            <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Mesa</div>
                            <div style="font-size:20px;color:#eee;font-weight:500;font-family:'Bebas Neue',sans-serif;letter-spacing:1px;">Mesa @Model.Mesa.Numero</div>
                        </div>
                    }

                    <div>
                        <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Data do Pedido</div>
                        <div style="font-size:14px;color:#bbb;">@Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div>
                        <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Status</div>
                        <span style="@statusStyle font-size:11px;padding:3px 10px;border-radius:20px;display:inline-block;">@statusText</span>
                    </div>

                    <div style="background:#0d0d0d;border:1px solid #1f1f1f;border-radius:8px;padding:14px;">
                        <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:4px;">Total do Pedido</div>
                        <div style="font-family:'Bebas Neue',sans-serif;font-size:36px;color:#4caf50;line-height:1;">
                            R$ @Model.ValorTotal.ToString("F2")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Cliente != null)
        {
            <div class="card mb-3">
                <div class="card-header" style="border-left:3px solid #42a5f5;">
                    <span class="card-title">Cliente</span>
                </div>
                <div class="card-body">
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <div>
                            <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Nome</div>
                            <div style="font-size:15px;color:#eee;font-weight:500;">@Model.Cliente.Nome</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Cliente.Telefone))
                        {
                            <div>
                                <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Telefone</div>
                                <div style="font-size:13px;color:#bbb;">@Model.Cliente.Telefone</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Cliente.Email))
                        {
                            <div>
                                <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">E-mail</div>
                                <div style="font-size:13px;color:#bbb;">@Model.Cliente.Email</div>
                            </div>
                        }

                        @if (isDelivery)
                        {
                            <div style="border-top:1px solid #1f1f1f;padding-top:12px;">
                                <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:6px;">Endereço de Entrega</div>
                                @if (endereco != null)
                                {
                                    <div style="background:#0d0d0d;border:1px solid #1f1f1f;border-radius:8px;padding:12px;">
                                        <div style="font-size:13px;color:#ccc;line-height:1.6;">
                                            @endereco.Rua@(!string.IsNullOrWhiteSpace(endereco.Numero) ? ", " + endereco.Numero : "")<br />
                                            @if (!string.IsNullOrWhiteSpace(endereco.Bairro))
                                            {
                                                <text>@endereco.Bairro<br /></text>
                                            }
                                            @endereco.Cidade
                                            @if (!string.IsNullOrWhiteSpace(endereco.CEP))
                                            {
                                                <span style="color:#555;font-size:12px;">  @endereco.CEP</span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="background:rgba(224,80,80,0.08);border:1px solid rgba(224,80,80,0.2);border-radius:8px;padding:10px;font-size:12px;color:#e05050;">
                                        ⚠ Endereço não cadastrado para este cliente.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.StatusPedido == SistemaHamburgueria.Enums.StatusPedido.EmPreparo)
        {
            <div class="card mb-3">
                <div class="card-header" style="border-left:3px solid #4caf50;">
                    <span class="card-title">Finalizar Pedido</span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Finalizar", "Pedido", new { id = Model.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Forma de Pagamento</label>
                            <select name="formaPagamento" class="form-select">
                                <option value="1"> Dinheiro</option>
                                <option value="2"> Cartao Credito</option>
                                <option value="3"> Cartao Debito</option>
                                <option value="4"> Pix</option>
                            </select>
                        </div>
                        <button type="submit"
                                style="width:100%;background:rgba(76,175,80,0.1);border:1px solid rgba(76,175,80,0.3);color:#4caf50;border-radius:8px;padding:10px;font-size:13px;font-family:'DM Sans',sans-serif;cursor:pointer;font-weight:500;"
                                onmouseover="this.style.background='rgba(76,175,80,0.2)'"
                                onmouseout="this.style.background='rgba(76,175,80,0.1)'"
                                onclick="return confirm('Finalizar pedido?')">
                             Finalizar Pedido
                        </button>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
                    @Html.ActionLink("+ Adicionar Item", "AddItem", new { id = Model.Id }, new
                    {
                        style = "width:100%;background:#E8650A;border:none;color:#fff;border-radius:8px;padding:10px;font-size:13px;text-align:center;text-decoration:none;display:block;font-weight:500;"
                    })
                    @using (Html.BeginForm("Cancelar", "Pedido", new { id = Model.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                style="width:100%;background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.3);color:#e05050;border-radius:8px;padding:10px;font-size:13px;font-family:'DM Sans',sans-serif;cursor:pointer;"
                                onmouseover="this.style.background='rgba(224,80,80,0.2)'"
                                onmouseout="this.style.background='rgba(224,80,80,0.1)'"
                                onclick="return confirm('Cancelar pedido?')">
                             Cancelar Pedido
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-md-8">
        <div class="card" style="height:100%;">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="card-title">Itens do Pedido</span>
                <span style="background:rgba(232,101,10,0.12);color:#E8650A;font-size:11px;padding:3px 10px;border-radius:20px;">
                    @Model.ItensPedido.Count() itens
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Qtd</th>
                            <th>Preco Unit</th>
                            <th>Subtotal</th>
                            @if (Model.StatusPedido == SistemaHamburgueria.Enums.StatusPedido.EmPreparo)
                            {
                                <th style="text-align:right;">Acao</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ItensPedido.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;padding:40px;color:#555;font-size:13px;">
                                    Nenhum item neste pedido.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.ItensPedido)
                        {
                            <tr>
                                <td style="font-weight:500;">@item.Produto.Nome</td>
                                <td>
                                    <span style="background:#1f1f1f;border:1px solid #2a2a2a;color:#ccc;font-size:12px;padding:2px 10px;border-radius:6px;">
                                        @item.Quantidade
                                    </span>
                                </td>
                                <td style="color:#aaa;font-size:13px;">R$ @item.PrecoUnitario.ToString("F2")</td>
                                <td style="color:#4caf50;font-weight:500;">R$ @item.Subtotal.ToString("F2")</td>
                                @if (Model.StatusPedido == SistemaHamburgueria.Enums.StatusPedido.EmPreparo)
                                {
                                    <td style="text-align:right;">
                                        @using (Html.BeginForm("RemoverItem", "Pedido", new { id = item.Id }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    style="background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:6px;padding:4px 12px;font-size:12px;cursor:pointer;font-family:'DM Sans',sans-serif;"
                                                    onmouseover="this.style.background='rgba(224,80,80,0.2)'"
                                                    onmouseout="this.style.background='rgba(224,80,80,0.1)'"
                                                    onclick="return confirm('Remover item?')">
                                                Remover
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="border-top:1px solid #2a2a2a;">
                            <td colspan="3" style="text-align:right;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:#444;padding-right:16px;">
                                Total
                            </td>
                            <td colspan="2" style="color:#4caf50;font-weight:500;font-size:16px;">
                                R$ @Model.ValorTotal.ToString("F2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>