@model SistemaHamburgueria.Models.Mesa

@{
    ViewBag.Title = "Nova Mesa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Nova Mesa</h2>

<div class="card p-4">
    @using (Html.BeginForm())
    {
        <div class="mb-3">
            @Html.LabelFor(m => m.Numero, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Numero, new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-success">Salvar</button>
        <a href="/Mesa" class="btn btn-secondary">Voltar</a>
    }
</div>