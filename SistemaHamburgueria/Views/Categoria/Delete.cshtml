@model SistemaHamburgueria.Models.Categoria
@{
    ViewBag.Title = "Remover Categoria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:2px;color:#e05050;text-transform:uppercase;">Atenção</div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:#f0f0f0;line-height:1;">Remover Categoria</div>
    </div>
    @Html.ActionLink("← Voltar", "Index", null, new { @class = "btn btn-sm", style = "background:#1f1f1f;border:1px solid #333;color:#ccc;border-radius:6px;" })
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header" style="border-left: 3px solid #e05050;">
                <span class="card-title" style="color:#e05050;">⚠ Confirmar exclusão</span>
            </div>
            <div class="card-body">
                <p style="font-size:13px;color:#666;margin-bottom:20px;">
                    Essa ação é permanente e não pode ser desfeita. Deseja realmente remover esta categoria?
                </p>

                <div style="background:#0d0d0d;border:1px solid #1f1f1f;border-radius:10px;padding:16px;margin-bottom:24px;">
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <div>
                            <div style="font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#444;margin-bottom:3px;">Nome</div>
                            <div style="font-size:15px;color:#eee;font-weight:500;">@Model.Nome</div>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm("Delete", "Categoria", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit"
                                style="flex:1;background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.3);color:#e05050;border-radius:8px;padding:10px;font-size:13px;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .15s;"
                                onmouseover="this.style.background='rgba(224,80,80,0.2)'"
                                onmouseout="this.style.background='rgba(224,80,80,0.1)'">
                            Sim, remover
                        </button>
                        @Html.ActionLink("Cancelar", "Index", null, new
                        {
                            style = "flex:1;background:#161616;border:1px solid #2a2a2a;color:#ccc;border-radius:8px;padding:10px;font-size:13px;text-align:center;text-decoration:none;display:block;"
                        })
                    </div>
                }
            </div>
        </div>
    </div>
</div>