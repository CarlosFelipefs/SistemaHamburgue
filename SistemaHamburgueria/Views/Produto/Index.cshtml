@model IEnumerable<SistemaHamburgueria.Models.Produto>
@{
    ViewBag.Title = "Produtos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Sucesso"] != null)
{
    <div style="background:rgba(76,175,80,0.1);border:1px solid rgba(76,175,80,0.2);color:#4caf50;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ✓ @TempData["Sucesso"]
    </div>
}
@if (TempData["Erro"] != null)
{
    <div style="background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ⚠ @TempData["Erro"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:2px;color:#E8650A;text-transform:uppercase;">Cardápio</div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:#f0f0f0;line-height:1;">Produtos</div>
    </div>
    @Html.ActionLink("+ Novo Produto", "Create", null, new
    {
        style = "background:#2e7d32;border:none;color:#fff;border-radius:8px;padding:8px 18px;font-size:13px;font-family:'DM Sans',sans-serif;text-decoration:none;font-weight:500;"
    })
</div>

<!-- STATS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Total de Produtos</div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card highlight">
            <div class="stat-label">Ticket Médio</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Average(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Mais Barato</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Min(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Mais Caro</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Max(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
</div>

<!-- BUSCA -->
<div class="card mb-3">
    <div class="card-body" style="padding:14px 18px;">
        <div class="d-flex gap-3 align-items-center">
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Buscar produto ou categoria..."
                   style="max-width:340px;" />
            <span style="font-size:12px;color:#444;" id="countLabel">@Model.Count() produtos</span>
        </div>
    </div>
</div>

<!-- TABELA -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="tabelaProdutos">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Produto</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:40px;color:#555;font-size:13px;">
                            Nenhum produto encontrado.
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-family:'Bebas Neue',sans-serif;font-size:16px;">@i</td>
                        <td style="font-weight:500;">@item.Nome</td>
                        <td>
                            <span style="background:rgba(232,101,10,0.12);color:#E8650A;font-size:11px;padding:3px 10px;border-radius:20px;display:inline-block;">
                                @(item.Categoria?.Nome ?? "—")
                            </span>
                        </td>
                        <td style="color:#4caf50;font-weight:500;">R$ @item.Preco.ToString("F2")</td>
                        <td style="text-align:right;">
                            @Html.ActionLink("Detalhes", "Details", new { id = item.Id }, new
                            {
                                style = "background:#1f1f1f;border:1px solid #2a2a2a;color:#ccc;border-radius:6px;padding:5px 12px;font-size:12px;text-decoration:none;margin-right:4px;"
                            })
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new
                            {
                                style = "background:#1f1f1f;border:1px solid #2a2a2a;color:#ccc;border-radius:6px;padding:5px 12px;font-size:12px;text-decoration:none;margin-right:4px;"
                            })
                            @Html.ActionLink("Excluir", "Delete", new { id = item.Id }, new
                            {
                                style = "background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:6px;padding:5px 12px;font-size:12px;text-decoration:none;"
                            })
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    const input = document.getElementById('searchInput');
    const rows = document.querySelectorAll('#tabelaProdutos tbody tr');
    const label = document.getElementById('countLabel');

    input.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        let visible = 0;
        rows.forEach(row => {
            const match = row.innerText.toLowerCase().includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        label.textContent = visible + ' produto' + (visible !== 1 ? 's' : '');
    });
</script>