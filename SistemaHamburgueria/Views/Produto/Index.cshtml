@model IEnumerable<SistemaHamburgueria.Models.Produto>
@{
    ViewBag.Title = "Produtos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:2px;color:#E8650A;text-transform:uppercase;">Cardápio</div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:32px;letter-spacing:2px;color:#f0f0f0;line-height:1;">Produtos</div>
    </div>
    @Html.ActionLink("+ Novo Produto", "Create", null, new { @class = "btn btn-primary" })
</div>

<!-- STATS RÁPIDOS -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Total de Produtos</div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card highlight">
            <div class="stat-label">Ticket Médio</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Average(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Mais Barato</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Min(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Mais Caro</div>
            <div class="stat-value">R$@(Model.Any() ? Model.Max(p => p.Preco).ToString("F2") : "0,00")</div>
        </div>
    </div>
</div>

<!-- BUSCA -->
<div class="card mb-3">
    <div class="card-body" style="padding:14px 18px;">
        <div class="d-flex gap-3 align-items-center">
            <input type="text" id="searchInput" class="form-control" placeholder="Buscar produto ou categoria..." style="max-width:340px;" />
            <span style="font-size:12px;color:#444;" id="countLabel">@Model.Count() produtos</span>
        </div>
    </div>
</div>

<!-- TABELA -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="tabelaProdutos">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Produto</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th style="text-align:right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="color:#333;font-family:'Bebas Neue',sans-serif;font-size:16px;">@i</td>
                        <td style="font-weight:500;color:#ddd;">@item.Nome</td>
                        <td>
                            <span class="badge badge-warning">@(item.Categoria?.Nome ?? "—")</span>
                        </td>
                        <td style="color:#E8650A;font-weight:500;">R$ @item.Preco.ToString("F2")</td>
                        <td style="text-align:right;">
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm", style = "background:#1f1f1f;border:1px solid #333;color:#ccc;border-radius:6px;font-size:12px;" })
                            @Html.ActionLink("Excluir", "Delete", new { id = item.Id }, new { @class = "btn btn-sm", style = "background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:6px;font-size:12px;" })
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    const input = document.getElementById('searchInput');
    const rows = document.querySelectorAll('#tabelaProdutos tbody tr');
    const label = document.getElementById('countLabel');

    input.addEventListener('input', function () {
        const q = this.value.toLowerCase();
        let visible = 0;
        rows.forEach(row => {
            const match = row.innerText.toLowerCase().includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        label.textContent = visible + ' produto' + (visible !== 1 ? 's' : '');
    });
</script>