@model IEnumerable<SistemaHamburgueria.Models.Cliente>
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Sucesso"] != null)
{
    <div style="background:rgba(76,175,80,0.1);border:1px solid rgba(76,175,80,0.2);color:#4caf50;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ✓ @TempData["Sucesso"]
    </div>
}
@if (TempData["Erro"] != null)
{
    <div style="background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;">
        ⚠ @TempData["Erro"]
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="card-title" style="font-size:15px;">Clientes</span>
        @Html.ActionLink("+ Novo Cliente", "Create", null, new
        {
            style = "background:#2e7d32;border:none;color:#fff;border-radius:8px;padding:8px 18px;font-size:13px;font-family:'DM Sans',sans-serif;text-decoration:none;font-weight:500;"
        })
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th style="text-align:right;">Acoes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align:center;padding:40px;color:#333;font-size:13px;">
                            Nenhum cliente cadastrado.
                        </td>
                    </tr>
                }
                @{ int i = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="color:#444;font-family:'Bebas Neue',sans-serif;font-size:16px;">@i</td>
                        <td style="color:#ddd;font-weight:500;">@item.Nome</td>
                        <td style="color:#888;font-size:13px;">@item.Telefone</td>
                        <td style="text-align:right;">
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new
                            {
                                style = "background:#1f1f1f;border:1px solid #2a2a2a;color:#ccc;border-radius:6px;padding:5px 12px;font-size:12px;text-decoration:none;margin-right:6px;"
                            })
                            @Html.ActionLink("Excluir", "Delete", new { id = item.Id }, new
                            {
                                style = "background:rgba(224,80,80,0.1);border:1px solid rgba(224,80,80,0.2);color:#e05050;border-radius:6px;padding:5px 12px;font-size:12px;text-decoration:none;"
                            })
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>